{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flux-money",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-08",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "r2_buckets": [
    {
      "binding": "FLUX_DATA",
      "bucket_name": "flux-data"
    }
  ],
  "observability": {
    "enabled": true
  }
}
